---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/feed/PostList.astro';
import { publishedPosts } from '../../lib/feed';

const posts = publishedPosts(await getCollection('feed'), import.meta.env.DEV);
---

<BaseLayout title="Feed" description="Where Marcus thinks out loud as the Freehold philosophy evolves.">
  <h1 class="font-serif text-h1 font-semibold tracking-[-0.015em] text-fg">Feed</h1>
  <p class="mt-4 max-w-measure font-serif text-lead text-fg italic">
    Where I think out loud as the philosophy evolves. The raw captures in the repo are the seed; these are the digested versions.
  </p>
  <p class="mt-3 font-sans text-ui text-muted">
    <a
      href="/feed.xml"
      class="underline decoration-muted underline-offset-[0.2em] transition-colors duration-[var(--motion-fast)] ease-out hover:text-fg"
    >Subscribe by RSS</a>
  </p>

  <div class="mt-10 sm:mt-12">
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-muted">Nothing here yet.</p>}
  </div>
</BaseLayout>
