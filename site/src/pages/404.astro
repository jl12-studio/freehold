---
import BaseLayout from '../layouts/BaseLayout.astro';

const parts = [
  { href: '/', label: 'Philosophy', note: 'what Freehold means and why' },
  { href: '/standard', label: 'Standard', note: 'the ten points software has to meet' },
  { href: '/feed', label: 'Feed', note: 'thinking out loud, newest first' },
  { href: '/marketplace', label: 'Marketplace', note: 'software that meets the standard' },
];
---

<BaseLayout title="Not found" description="This page does not exist." indexable={false}>
  <h1 class="font-serif text-h1 font-semibold tracking-[-0.015em] text-fg">Nothing is here.</h1>
  <p class="mt-4 max-w-measure font-serif text-lead text-fg italic">
    The page you asked for does not exist, or it moved. Nothing was lost; the rest of the site is where you left it.
  </p>
  <p class="mt-8 font-sans text-ui text-muted">Start from one of the four parts:</p>
  <ul class="mt-3 max-w-measure">
    {
      parts.map((part) => (
        <li class="border-b border-rule py-3 first:border-t">
          <a
            href={part.href}
            class="font-serif text-h3 font-semibold text-fg underline decoration-accent/55 underline-offset-[0.2em] transition-colors duration-[var(--motion-fast)] ease-out hover:text-accent hover:decoration-accent"
          >{part.label}</a>
          <span class="ml-2 font-sans text-caption text-muted">{part.note}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
