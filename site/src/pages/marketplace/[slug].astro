---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import Checklist from '../../components/marketplace/Checklist.astro';
import { passCount } from '../../lib/registry';
import { formatLogDate } from '../../lib/log-date';

export async function getStaticPaths() {
  const entries = await getCollection('registry');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { pass, na } = passCount(entry);
const updated = data.updated.toISOString().slice(0, 10);
const link = 'text-fg underline decoration-accent/55 underline-offset-[0.2em] hover:text-accent';
---

<BaseLayout title={data.name} description={data.oneLine}>
  <header>
    <h1 transition:name={`app-title-${entry.id}`} class="w-fit max-w-full font-serif text-h1 font-semibold tracking-[-0.015em]">{data.name}</h1>
    <p class="mt-5 font-serif text-lead text-fg italic">{data.oneLine}</p>
    <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-sans text-caption text-muted">
      <StatusBadge status={data.status} />
      <span><span class="capitalize">{data.stage}</span> stage</span>
    </p>
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-sans text-ui text-muted">
      {
        data.repo ? (
          <a href={data.repo} class={link}>Repository</a>
        ) : (
          <span>Repository coming soon</span>
        )
      }
      {data.homepage && <a href={data.homepage} class={link}>Homepage</a>}
    </p>
    <p class="label mt-4">
      Maintainer:{' '}
      {data.maintainer.url ? <a href={data.maintainer.url} class={link}>{data.maintainer.name}</a> : data.maintainer.name}{' '}
      <span aria-hidden="true">·</span>{' '}
      Updated <time datetime={updated}>{formatLogDate(updated)}</time>
    </p>
  </header>

  <section class="mt-10 sm:mt-12" aria-labelledby="checklist-heading">
    <h2 id="checklist-heading" class="font-serif text-h2 font-semibold">The checklist</h2>
    <p class="mt-3 font-sans text-ui text-muted tabular-nums">{pass} of 10 pass. {na} not applicable at this stage.</p>
    <div class="mt-4">
      <Checklist standard={data.standard} />
    </div>
    <p class="mt-6">
      <a href="/standard/" class="underline decoration-accent/55 underline-offset-[0.2em] hover:text-accent">Read the full standard.</a>
    </p>
  </section>
</BaseLayout>
