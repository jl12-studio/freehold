---
/*
 * "Get it" on a marketplace detail page (DESIGN.md, "Get it"): the one sentence to
 * paste to your agent, a Copy button, and the supporting links. Renders nothing for
 * an entry with no agentPrompt, install or release.
 */
import CopyPrompt from './CopyPrompt.vue';
import { getItLinks, hasGetIt, type RegistryData } from '../../lib/registry';

interface Props {
  data: RegistryData;
}

const { data } = Astro.props;
const links = getItLinks(data);
const link = 'text-fg underline decoration-accent/55 underline-offset-[0.2em] hover:text-accent';
---

{
  hasGetIt(data) && (
    <section class="mt-10 sm:mt-12" aria-labelledby="get-heading">
      <h2 id="get-heading" class="font-serif text-h2 font-semibold">Get it</h2>
      {data.agentPrompt && (
        <>
          <p class="mt-3 text-muted">Paste this to your agent. It downloads the app, checks it, installs it and connects itself.</p>
          <p id="get-it-sentence" class="rule-double-t rule-double-b mt-4 py-5 font-serif text-lead text-fg [overflow-wrap:anywhere]">{data.agentPrompt}</p>
          <CopyPrompt client:visible text={data.agentPrompt} targetId="get-it-sentence" />
        </>
      )}
      {links.length > 0 && (
        <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-sans text-ui text-muted">
          {links.map(({ label, href }) => (
            <a href={href} rel="noopener" class={link}>{label}</a>
          ))}
        </p>
      )}
    </section>
  )
}
