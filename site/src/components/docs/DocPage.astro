---
/*
 * Shared shell for / and /standard: BaseLayout (wide), an optional hero slot,
 * an optional intro slot, an optional annex slot (the standard's schedule), then
 * the doc-grid with the table of contents and the rendered Markdown in .prose
 * (DESIGN.md, "Hero", "Table of contents" and "The deed").
 */
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from './Toc.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  /** Page name for the <title>; omit on the home page. */
  title?: string;
  description?: string;
  /** Number the h2 articles in Roman capitals (text and TOC) and drop-cap the first one. */
  numbered?: boolean;
}

const { entry, title, description, numbered = false } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout title={title} description={description} wide>
  <slot name="hero" />

  {
    Astro.slots.has('intro') && (
      <div class="doc-intro mt-0 mb-10 max-w-measure font-serif text-lead text-fg italic sm:mb-12">
        <slot name="intro" />
      </div>
    )
  }

  <slot name="annex" />

  <div class="doc-grid mt-12 sm:mt-14 lg:mt-16 lg:grid lg:grid-cols-[var(--container-toc)_minmax(0,var(--container-measure))] lg:gap-x-16">
    <Toc headings={headings} numbered={numbered} />

    <article class:list={['prose', numbered && 'prose-numbered']}>
      <Content />
    </article>
  </div>
</BaseLayout>
