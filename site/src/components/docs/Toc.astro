---
/*
 * Table of contents for the document pages (DESIGN.md, "Table of contents").
 * One copy of the entries, in a single <details>: below lg it is the collapsible
 * "Contents" block above the article; from lg the summary is hidden, the content
 * is forced open with ::details-content, and the block sticks under the header.
 * No JavaScript either way. Only h2 and h3 appear; links are #<slug>.
 * With numbered, each h2 entry carries the same Roman numeral as its article.
 */
import type { MarkdownHeading } from 'astro';
import { toRoman } from '../../lib/roman';

interface Props {
  headings: MarkdownHeading[];
  numbered?: boolean;
}

const { numbered = false } = Astro.props;
const items = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

let article = 0;
const entries = items.map((item) => ({ ...item, numeral: item.depth === 2 ? toRoman(++article) : null }));
---

<nav aria-label="Contents" class="toc-nav">
  <details class:list={['toc mb-10 rule-double-t rule-double-b font-sans text-ui lg:sticky lg:top-[var(--header-offset)] lg:mb-0 lg:border-0 lg:text-caption', numbered && 'toc-numbered']}>
    <summary class="cursor-pointer py-3.5 font-[560] text-fg marker:text-muted">Contents</summary>
    <div class="pb-3.5 lg:pb-0">
      <p class="eyebrow mb-4 hidden text-fg lg:block">Contents</p>
      <ol class="lg:space-y-2 lg:border-l lg:border-rule">
        {
          entries.map((item) => (
            <li class:list={[item.depth === 3 ? 'toc-sub pl-4 lg:pl-7' : 'lg:pl-4']}>
              <a href={`#${item.slug}`} class="toc-link block py-2 text-muted no-underline hover:text-fg lg:py-0">
                {numbered && item.numeral && <span class="toc-num" aria-hidden="true">{item.numeral}</span>}
                <span>{item.text}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </details>
</nav>

<style>
  /* From lg the double rules give way to the rail; the <details> is a plain list. */
  @media (min-width: 64rem) {
    .toc::before,
    .toc::after {
      display: none;
    }

    @supports selector(::details-content) {
      .toc > summary {
        display: none;
      }

      .toc::details-content {
        display: block;
        content-visibility: visible;
      }
    }
  }

  /* Numerals sit in a fixed column so the titles line up; sub-entries align with the titles. */
  .toc-numbered .toc-link {
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr);
    align-items: baseline;
  }

  .toc-numbered .toc-sub {
    padding-left: calc(2.4em + 0.75rem);
  }

  .toc-numbered .toc-sub .toc-link {
    display: block;
  }

  @media (min-width: 64rem) {
    .toc-numbered .toc-sub {
      padding-left: calc(1rem + 2.4em);
    }
  }

  .toc-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }
</style>
