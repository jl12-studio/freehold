---
/*
 * The feed list: date, title (linking to the post), summary. Newest first is
 * the caller's job (publishedPosts). No cards: space and type carry the rows.
 */
import type { CollectionEntry } from 'astro:content';
import { slugFromId } from '../../lib/feed';
import PostMeta from './PostMeta.astro';

interface Props {
  posts: CollectionEntry<'feed'>[];
}

const { posts } = Astro.props;
---

<ol class="list-none space-y-10 p-0 sm:space-y-12">
  {
    posts.map((post) => (
      <li class="reveal">
        <PostMeta date={post.data.date} draft={post.data.draft} />
        <h2 class="mt-1.5 font-serif text-h3 text-fg">
          <a
            href={`/feed/${slugFromId(post.id)}/`}
            transition:name={`post-title-${slugFromId(post.id)}`}
            class="inline-block underline decoration-accent/55 decoration-1 underline-offset-[0.2em] transition-colors duration-[var(--motion-fast)] ease-out hover:text-accent hover:decoration-accent"
          >
            {post.data.title}
          </a>
        </h2>
        {post.data.summary && <p class="mt-2 font-serif text-body text-muted">{post.data.summary}</p>}
      </li>
    ))
  }
</ol>
