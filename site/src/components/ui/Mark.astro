---
/**
 * The Freehold mark: the wordmark's F, set in a square plot like a seal on a deed.
 * Same geometry as public/favicon.svg. Decorative; the wordmark text carries the name.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['fh-mark', className]} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="6" fill="var(--color-accent)"></rect>
  <path d="M8 7H24V12.5H21.5V10H14.5V14.75H20V17.75H14.5V22H17.5V25H8V22H10.5V10H8Z" fill="var(--color-bg)"></path>
</svg>
