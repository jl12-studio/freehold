---
/**
 * Checklist status for one point of the standard. Text plus a glyph, never color alone.
 * DESIGN.md, "Status colors", is the binding spec.
 */
interface Props {
  status: 'pass' | 'not-yet' | 'n/a';
  class?: string;
}

const { status, class: className } = Astro.props;

const meta = {
  pass: { label: 'Pass', glyph: '✓', tone: 'text-pass' },
  'not-yet': { label: 'Not yet', glyph: '○', tone: 'text-not-yet' },
  'n/a': { label: 'n/a', glyph: '–', tone: 'text-na' },
}[status];
---

<span
  class:list={['inline-flex items-center gap-1.5 font-sans text-caption font-[560] whitespace-nowrap', meta.tone, className]}
  data-status={status}
>
  <span aria-hidden="true" class="inline-block w-[1em] text-center">{meta.glyph}</span>
  {meta.label}
</span>
